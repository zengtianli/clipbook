    "iCloud 已开启，等待同步": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已开启，等待同步"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is on, waiting to sync"
          }
        }
      }
    },
    "iCloud 已开启，等待已有配置；空白配置不会覆盖云端": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已开启，等待已有配置；空白配置不会覆盖云端"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is on and waiting for existing settings; blank settings never overwrite iCloud"
          }
        }
      }
    },
    "iCloud 文件协调没有返回结果": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 文件协调没有返回结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud file coordination returned no result"
          }
        }
      }
    },
    "iCloud 登录状态改变，已暂停同步；本地记录保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 登录状态改变，已暂停同步；本地记录保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud sign-in changed; sync is paused and local clips are kept."
          }
        }
      }
    },
    "iCloud 账户已变化。已保留本地记录并暂停同步，请切回原账户，避免把历史上传到其他账户。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账户已变化。已保留本地记录并暂停同步，请切回原账户，避免把历史上传到其他账户。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud account changed. Local clips are kept and sync is paused; switch back to the original account so history is not uploaded to another account."
          }
        }
      }
    },
    "iCloud 配置同步已关闭": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 配置同步已关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud settings sync is off"
          }
        }
      }
    },
    "iCloud 配置暂未完成上传，请稍后重试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 配置暂未完成上传，请稍后重试"
